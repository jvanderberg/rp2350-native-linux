Subject: [PATCH] armv7m: spill text and relocations to disk for native links

--- a/tcc.h
+++ b/tcc.h
@@ -602,6 +602,9 @@
 typedef struct Section {
     unsigned long data_offset; /* current data offset */
     unsigned char *data;       /* section data */
+#ifdef TCC_ARM_THUMB
+    int spill_fd;              /* optional disk-backed text section */
+#endif
     unsigned long data_allocated; /* used for realloc() handling */
     TCCState *s1;
     int sh_name;             /* elf section name (only used during output) */
--- a/libtcc.c
+++ b/libtcc.c
@@ -872,6 +872,15 @@
 /* compile the file opened in 'file'. Return non zero if errors. */
 static int tcc_compile(TCCState *s1, int filetype, const char *str, int fd)
 {
+#ifdef TCC_ARM_THUMB
+    /* Startup objects can already be in scratch storage. Code generation
+       requires a memory-backed text section. */
+    if (text_section && text_section->spill_fd) {
+        if (fd > 0)
+            close(fd);
+        return tcc_error_noabort("link scratch requires separate object compilation");
+    }
+#endif
     /* Here we enter the code section where we use the global variables for
        parsing and code generation (tccpp.c, tccgen.c, <target>-gen.c).
        Other threads need to wait until we're done.
--- a/tccelf.c
+++ b/tccelf.c
@@ -131,6 +131,12 @@
 {
     if (!s)
         return;
+#ifdef TCC_ARM_THUMB
+    if (s->spill_fd) {
+        close(s->spill_fd);
+        s->spill_fd = 0;
+    }
+#endif
     tcc_free(s->data);
     s->data = NULL;
     s->data_allocated = s->data_offset = 0;
@@ -297,6 +303,124 @@
     return symtab;
 }
 
+#ifdef TCC_ARM_THUMB
+/* Opt-in scratch storage for the merged Thumb code and its relocations
+   during a static object-only link. The linker accesses either section a
+   page at a time, keeping the writable ATRANS window available for symbols
+   and the smaller sections. */
+#define TEXT_PAGE 4096
+
+static void spill_error(TCCState *s1)
+{
+    tcc_error_noabort("link scratch I/O: %s", strerror(errno));
+    exit(1);
+}
+
+static void spill_open(Section *s)
+{
+    TCCState *s1 = s->s1;
+    const char *dir = getenv("TCC_LINK_SCRATCH");
+    char *path;
+    if (!dir || !*dir || s->data_offset
+        || (s != text_section && (s->sh_type != SHT_RELX
+            || strcmp(s->name, ".rel.text") || !text_section->spill_fd))
+        || s1->output_type != TCC_OUTPUT_EXE || !s1->static_link
+        || s1->output_format != TCC_OUTPUT_FORMAT_ELF || s->spill_fd)
+        return;
+    path = tcc_malloc(strlen(dir) + sizeof "/tcc-text.XXXXXX");
+    sprintf(path, "%s/tcc-text.XXXXXX", dir);
+    s->spill_fd = mkstemp(path);
+    if (s->spill_fd < 0 || unlink(path) < 0)
+        spill_error(s->s1);
+    /* fd zero can only occur if the caller closed stdin. */
+    if (s->spill_fd == 0) {
+        s->spill_fd = fcntl(0, F_DUPFD, 3);
+        close(0);
+        if (s->spill_fd < 0)
+            spill_error(s->s1);
+    }
+    tcc_free(path);
+}
+
+static void spill_read(Section *s, void *buf, size_t len, unsigned long offset)
+{
+    if (lseek(s->spill_fd, offset, SEEK_SET) < 0
+        || full_read(s->spill_fd, buf, len) != len)
+        spill_error(s->s1);
+}
+
+static void spill_write(Section *s, const void *buf, size_t len, unsigned long offset)
+{
+    const char *p = buf;
+    if (lseek(s->spill_fd, offset, SEEK_SET) < 0)
+        spill_error(s->s1);
+    while (len) {
+        ssize_t n = write(s->spill_fd, p, len);
+        if (n < 0 && errno == EINTR)
+            continue;
+        if (n <= 0)
+            spill_error(s->s1);
+        p += n;
+        len -= n;
+    }
+}
+
+static void spill_append(Section *s, int fd, size_t len, unsigned long offset)
+{
+    unsigned char buf[TEXT_PAGE];
+    while (len) {
+        size_t n = len < sizeof buf ? len : sizeof buf;
+        if (full_read(fd, buf, n) != n)
+            spill_error(s->s1);
+        spill_write(s, buf, n, offset);
+        offset += n;
+        len -= n;
+    }
+}
+/* Relocation entries can also exceed the native linker's RAM budget. */
+typedef struct {
+    Section *sec;
+    unsigned long next, end, page_off;
+    size_t page_len;
+    int writable;
+    ElfW_Rel page[TEXT_PAGE / sizeof(ElfW_Rel)];
+} SpillRelocs;
+
+static ElfW_Rel *spill_reloc_next(SpillRelocs *it)
+{
+    Section *sec = it->sec;
+    unsigned long off = it->next;
+    if (sec->spill_fd) {
+        if (it->end < off || (it->end - off) % sizeof(ElfW_Rel)) {
+            TCCState *s1 = sec->s1;
+            tcc_error_noabort("invalid scratch relocation range");
+            exit(1);
+        }
+        if (it->page_len && (off == it->end
+                || off >= it->page_off + it->page_len)) {
+            if (it->writable)
+                spill_write(sec, it->page, it->page_len, it->page_off);
+            it->page_len = 0;
+        }
+        if (off == it->end)
+            return NULL;
+        if (!it->page_len) {
+            it->page_off = off;
+            it->page_len = it->end - off;
+            if (it->page_len > sizeof it->page)
+                it->page_len = sizeof it->page;
+            spill_read(sec, it->page, it->page_len, off);
+        }
+        it->next += sizeof(ElfW_Rel);
+        return &it->page[(off - it->page_off) / sizeof(ElfW_Rel)];
+    }
+    if (off >= it->end || it->end - off < sizeof(ElfW_Rel))
+        return NULL;
+    it->next += sizeof(ElfW_Rel);
+    return (ElfW_Rel *)(sec->data + off);
+}
+#endif
+
