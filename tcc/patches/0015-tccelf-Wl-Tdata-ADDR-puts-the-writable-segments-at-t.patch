From a2460c11cb812194fc9640fe5c373d0f9c94a49a Mon Sep 17 00:00:00 2001
From: Josh Vanderberg <jvanderberg@gmail.com>
Date: Sun, 22 Nov 2026 12:31:02 -0600
Subject: [PATCH] tccelf: -Wl,-Tdata=ADDR puts the writable segments at their
 own address

This is for ATRANS v3 programs, where text is in a shared window and data in the per-process one: -Wl,-Ttext=0x11c00000 -Wl,-Tdata=0x11010000. The page offset stays the file's, so each p_vaddr is congruent to its p_offset.
---
 libtcc.c |  3 +++
 tcc.h    |  2 ++
 tccelf.c | 11 +++++++++--
 3 files changed, 14 insertions(+), 2 deletions(-)

diff --git a/libtcc.c b/libtcc.c
index 827687c..e198db6 100644
--- a/libtcc.c
+++ b/libtcc.c
@@ -1514,6 +1514,9 @@ static int tcc_set_linker(TCCState *s, const char *optarg)
         } else if (link_option(&o, "image-base=|Ttext=")) {
             s->text_addr = strtoull(o.arg, &end, 16);
             s->has_text_addr = 1;
+        } else if (link_option(&o, "Tdata=")) {
+            s->data_addr = strtoull(o.arg, &end, 16);
+            s->has_data_addr = 1;
         } else if (link_option(&o, "init=")) {
             tcc_set_str(&s->init_symbol, o.arg);
             ignoring = 1;
diff --git a/tcc.h b/tcc.h
index 1dcae8b..2f332a8 100644
--- a/tcc.h
+++ b/tcc.h
@@ -837,6 +837,8 @@ struct TCCState {
 
     unsigned char has_text_addr;
     addr_t text_addr; /* address of text section */
+    unsigned char has_data_addr;
+    addr_t data_addr; /* address of the first writable segment (-Tdata) */
     unsigned section_align; /* section alignment */
 #ifdef TCC_TARGET_I386
     int seg_size; /* 32. Can be 16 with i386 assembler (.code16) */
diff --git a/tccelf.c b/tccelf.c
index 2810322..e95f0f5 100644
--- a/tccelf.c
+++ b/tccelf.c
@@ -2424,7 +2424,7 @@ static int layout_sections(TCCState *s1, int *sec_order, struct dyn_inf *d)
     Section *s;
     addr_t addr, tmp, align, s_align, base;
     ElfW(Phdr) *ph = NULL, *ph2;
-    int i, f, n, phnum, phfill;
+    int i, f, n, phnum, phfill, data_placed;
     int file_offset;
 
     /* compute number of program headers */
@@ -2452,6 +2452,7 @@ static int layout_sections(TCCState *s1, int *sec_order, struct dyn_inf *d)
         file_offset += d->shnum * sizeof (ElfW(Shdr));
     }
 
+    data_placed = 0;
     s_align = ELF_PAGE_SIZE;
     if (s1->section_align)
         s_align = s1->section_align;
@@ -2491,7 +2492,13 @@ static int layout_sections(TCCState *s1, int *sec_order, struct dyn_inf *d)
             continue;
         }
 
-        if ((f & SHFX_NEWPH) && n) {
+        if ((f & SHFX_NEWPH) && n && (f & SHF_WRITE) && s1->has_data_addr && !data_placed) {
+            /* -Tdata: the writable segments go at their own address
+               (e.g. the ATRANS v3 data window, text in another); the
+               offset in the page stays that of the file */
+            addr = s1->data_addr + (file_offset & (s_align - 1));
+            data_placed = 1;
+        } else if ((f & SHFX_NEWPH) && n) {
             /* different rwx section flags */
             if (s1->output_format == TCC_OUTPUT_FORMAT_ELF) {
                 /* if in the middle of a page, w e duplicate the page in
-- 
