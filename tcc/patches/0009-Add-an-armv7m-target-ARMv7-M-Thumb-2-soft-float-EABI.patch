diff --git a/lib/atomic-armv7m.c b/lib/atomic-armv7m.c
new file mode 100644
index 0000000..eacc10d
--- /dev/null
+++ b/lib/atomic-armv7m.c
@@ -0,0 +1,108 @@
+/* atomic-armv7m.c - the atomic functions that tcc calls on ARMv7-M
+   (__atomic_load_N & co, atomic_thread_fence, atomic_flag_*), which
+   atomic.S has only in ARM code.  Compiled by gcc (tcc has no Thumb-2
+   assembler): for 1, 2 and 4 bytes gcc makes LDREX/STREX loops; ARMv7-M
+   has no LDREXD, so 8-byte atomics take a spinlock. */
+
+#include <stdint.h>
+#include <stdbool.h>
+
+#define GEN(TYPE, N) \
+TYPE __atomic_load_##N(const volatile void *p, int m) \
+{ return __atomic_load_n((const volatile TYPE *)p, __ATOMIC_SEQ_CST); } \
+void __atomic_store_##N(volatile void *p, TYPE v, int m) \
+{ __atomic_store_n((volatile TYPE *)p, v, __ATOMIC_SEQ_CST); } \
+bool __atomic_compare_exchange_##N(volatile void *p, void *e, TYPE d, \
+    bool weak, int sm, int fm) \
+{ return __atomic_compare_exchange_n((volatile TYPE *)p, (TYPE *)e, d, 0, \
+    __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST); } \
+bool __atomic_test_and_set_##N(volatile void *p, int m) \
+{ return __atomic_exchange_n((volatile TYPE *)p, 1, __ATOMIC_SEQ_CST) != 0; }
+
+#pragma GCC diagnostic ignored "-Wbuiltin-declaration-mismatch"
+GEN(uint8_t, 1)
+GEN(uint16_t, 2)
+GEN(uint32_t, 4)
+
+static volatile uint32_t lock8;
+
+static void lock(void)
+{
+    while (__atomic_exchange_n(&lock8, 1, __ATOMIC_ACQUIRE))
+        ;
+}
+
+static void unlock(void)
+{
+    __atomic_store_n(&lock8, 0, __ATOMIC_RELEASE);
+}
+
+uint64_t __atomic_load_8(const volatile void *p, int m)
+{
+    uint64_t v;
+    lock();
+    v = *(const volatile uint64_t *)p;
+    unlock();
+    return v;
+}
+
+void __atomic_store_8(volatile void *p, uint64_t v, int m)
+{
+    lock();
+    *(volatile uint64_t *)p = v;
+    unlock();
+}
+
+bool __atomic_compare_exchange_8(volatile void *p, void *e, uint64_t d,
+    bool weak, int sm, int fm)
+{
+    bool ok;
+    lock();
+    ok = *(volatile uint64_t *)p == *(uint64_t *)e;
+    if (ok)
+        *(volatile uint64_t *)p = d;
+    else
+        *(uint64_t *)e = *(volatile uint64_t *)p;
+    unlock();
+    return ok;
+}
+
+bool __atomic_test_and_set_8(volatile void *p, int m)
+{
+    bool old;
+    lock();
+    old = *(volatile uint64_t *)p != 0;
+    *(volatile uint64_t *)p = 1;
+    unlock();
+    return old;
+}
+
+void atomic_thread_fence(int m)
+{
+    __atomic_thread_fence(__ATOMIC_SEQ_CST);
+}
+
+void atomic_signal_fence(int m)
+{
+    __atomic_signal_fence(__ATOMIC_SEQ_CST);
+}
+
+bool atomic_flag_test_and_set(volatile void *p)
+{
+    return __atomic_exchange_n((volatile uint8_t *)p, 1, __ATOMIC_SEQ_CST) != 0;
+}
+
+bool atomic_flag_test_and_set_explicit(volatile void *p, int m)
+{
+    return atomic_flag_test_and_set(p);
+}
+
+void atomic_flag_clear(volatile void *p)
+{
+    __atomic_store_n((volatile uint8_t *)p, 0, __ATOMIC_SEQ_CST);
+}
+
+void atomic_flag_clear_explicit(volatile void *p, int m)
+{
+    atomic_flag_clear(p);
+}
