From 592ef57ac08ae20d9fd67b5c8bad2954d28aaf6e Mon Sep 17 00:00:00 2001
From: Josh Vanderberg <jvanderberg@gmail.com>
Date: Sun, 22 Nov 2026 11:35:38 -0600
Subject: [PATCH 08/10] arm-link: Thumb-2 relocations for ARMv7-M programs

R_ARM_THM_MOVW_ABS_NC/MOVT_ABS take their addend from the instruction
(REL: the signed imm16) and replace the field instead of adding to it;
R_ARM_THM_JUMP19 (b<cond>.w), R_ARM_THM_JUMP11 and R_ARM_THM_JUMP8 (the
16-bit branches), which gcc's objects in libc.a and libgcc.a use, are
handled; a Thumb call doesn't dereference a missing .plt in a static
link. With TCC_ARM_THUMB, programs are linked at 0x11020000 with 4 KiB
pages: the ATRANS process window of native Linux on the RP2350.
---
 arm-link.c | 70 +++++++++++++++++++++++++++++++++++++++++++++---------
 elf.h      |  8 ++++++-
 2 files changed, 66 insertions(+), 12 deletions(-)

diff --git a/arm-link.c b/arm-link.c
index 0d416c6..93b1983 100644
--- a/arm-link.c
+++ b/arm-link.c
@@ -12,8 +12,15 @@
 
 #define R_NUM       R_ARM_NUM
 
+#ifdef TCC_ARM_THUMB
+/* ATRANS processes on the RP2350: static programs linked in the per-process
+   window at 0x11000000, the image at +128 KiB (the stack is below it) */
+#define ELF_START_ADDR 0x11020000
+#define ELF_PAGE_SIZE  0x1000
+#else
 #define ELF_START_ADDR 0x00010000
 #define ELF_PAGE_SIZE  0x10000
+#endif
 
 #define PCRELATIVE_DLLPLT 1
 #define RELOCATE_DLLPLT 1
@@ -53,6 +60,9 @@ ST_FUNC int code_reloc (int reloc_type)
 	case R_ARM_PLT32:
 	case R_ARM_THM_PC22:
 	case R_ARM_THM_JUMP24:
+	case R_ARM_THM_JUMP19:
+	case R_ARM_THM_PC11:
+	case R_ARM_THM_PC9:
 	case R_ARM_PREL31:
 	case R_ARM_V4BX:
 	case R_ARM_JUMP_SLOT:
@@ -80,6 +90,9 @@ ST_FUNC int gotplt_entry_type (int reloc_type)
 	case R_ARM_PLT32:
 	case R_ARM_THM_PC22:
 	case R_ARM_THM_JUMP24:
+	case R_ARM_THM_JUMP19:
+	case R_ARM_THM_PC11:
+	case R_ARM_THM_PC9:
 	case R_ARM_MOVT_ABS:
 	case R_ARM_MOVW_ABS_NC:
 	case R_ARM_THM_MOVT_ABS:
@@ -256,7 +269,7 @@ ST_FUNC void relocate(TCCState *s1, ElfW_Rel *rel, int type, unsigned char *ptr,
                 /* Relocation infos */
                 to_thumb = val & 1;
                 plt = s1->plt;
-                to_plt = (val >= plt->sh_addr) &&
+                to_plt = plt && (val >= plt->sh_addr) &&
                          (val < plt->sh_addr + plt->data_offset);
                 is_call = (type == R_ARM_THM_PC22);
 
@@ -350,18 +363,53 @@ ST_FUNC void relocate(TCCState *s1, ElfW_Rel *rel, int type, unsigned char *ptr,
         case R_ARM_THM_MOVT_ABS:
         case R_ARM_THM_MOVW_ABS_NC:
             {
-                int x, i, imm4, imm3, imm8;
+                /* the addend (REL) is the instruction's imm16, signed */
+                uint32_t insn = read32le(ptr), x;
+                int addend = ((insn & 0xf) << 12) | ((insn >> 10 & 1) << 11)
+                             | ((insn >> 28 & 7) << 8) | ((insn >> 16) & 0xff);
+                addend = (addend ^ 0x8000) - 0x8000;
+                val += addend;
                 if (type == R_ARM_THM_MOVT_ABS)
                     val >>= 16;
-                imm8 = val & 0xff;
-                imm3 = (val >> 8) & 0x7;
-                i = (val >> 11) & 1;
-                imm4 = (val >> 12) & 0xf;
-                x = (imm3 << 28) | (imm8 << 16) | (i << 10) | imm4;
-                if (type == R_ARM_THM_MOVT_ABS)
-                    write32le(ptr, read32le(ptr) | x);
-                else
-                    add32le(ptr, x);
+                x = ((val >> 12) & 0xf) | ((val >> 11 & 1) << 10)
+                    | ((val >> 8 & 7) << 28) | ((val & 0xff) << 16);
+                write32le(ptr, (insn & 0x8f00fbf0) | x);
+            }
+            return;
+        case R_ARM_THM_JUMP19: /* b<cond>.w */
+            {
+                int hi = read16le(ptr), lo = read16le(ptr + 2), x;
+                x = ((hi >> 10 & 1) << 20) | ((lo >> 11 & 1) << 19)
+                    | ((lo >> 13 & 1) << 18) | ((hi & 0x3f) << 12)
+                    | ((lo & 0x7ff) << 1);
+                x = (x ^ 0x100000) - 0x100000;
+                x += val - addr;
+                if (x >= 0x100000 || x < -0x100000 || !(val & 1))
+                    tcc_error_noabort("can't relocate value at %x,%d",addr, type);
+                write16le(ptr, (hi & 0xfbc0) | ((x >> 20 & 1) << 10)
+                               | ((x >> 12) & 0x3f));
+                write16le(ptr + 2, (lo & 0xd000) | ((x >> 18 & 1) << 13)
+                                   | ((x >> 19 & 1) << 11) | ((x >> 1) & 0x7ff));
+            }
+            return;
+        case R_ARM_THM_PC11: /* 16-bit b */
+            {
+                int insn = read16le(ptr), x;
+                x = ((insn & 0x7ff) ^ 0x400) - 0x400;
+                x = x * 2 + val - addr;
+                if (x >= 0x800 || x < -0x800 || !(val & 1))
+                    tcc_error_noabort("can't relocate value at %x,%d",addr, type);
+                write16le(ptr, (insn & 0xf800) | ((x >> 1) & 0x7ff));
+            }
+            return;
+        case R_ARM_THM_PC9: /* 16-bit b<cond> */
+            {
+                int insn = read16le(ptr), x;
+                x = ((insn & 0xff) ^ 0x80) - 0x80;
+                x = x * 2 + val - addr;
+                if (x >= 0x100 || x < -0x100 || !(val & 1))
+                    tcc_error_noabort("can't relocate value at %x,%d",addr, type);
+                write16le(ptr, (insn & 0xff00) | ((x >> 1) & 0xff));
             }
             return;
         case R_ARM_PREL31:
diff --git a/elf.h b/elf.h
index 05ea707..f6da57d 100644
--- a/elf.h
+++ b/elf.h
@@ -2520,7 +2520,13 @@ typedef Elf32_Addr Elf32_Conflict;
 #define R_ARM_MOVT_PREL 46  /* PC relative (MOVT).  */
 #define R_ARM_THM_MOVW_ABS_NC	47
 #define R_ARM_THM_MOVT_ABS	48
-/* Values from 49 to 89 are not yet used/handled by tcc. */
+#define R_ARM_THM_MOVW_PREL_NC	49
+#define R_ARM_THM_MOVT_PREL	50
+#define R_ARM_THM_JUMP19	51	/* thumb B<cond>.W */
+#define R_ARM_THM_JUMP6		52
+#define R_ARM_THM_ALU_PREL_11_0	53
+#define R_ARM_THM_PC12		54
+/* Values from 55 to 89 are not yet used/handled by tcc. */
 #define R_ARM_TLS_GOTDESC	90
 #define R_ARM_TLS_CALL		91
 #define R_ARM_TLS_DESCSEQ	92
-- 
