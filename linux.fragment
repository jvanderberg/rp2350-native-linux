# Native nommu Linux on the RP2350's Cortex-M33 (merged onto tinyconfig).
# CONFIG_MMU is not set
CONFIG_ARCH_RP2350=y
CONFIG_CPU_V7M_NUM_IRQ=52
# CONFIG_ARM_MPU is not set
# Kernel RAM: the 8 MiB PSRAM through the ATRANS5/6 windows (0x11400000);
# the ATRANS4 window at 0x11000000 is the ATRANS processes' (rp2350-atrans.c).
CONFIG_SET_MEM_PARAM=y
CONFIG_DRAM_BASE=0x11400000
CONFIG_DRAM_SIZE=0x00800000
# Kernel text runs in place from flash (the swap area, below the Wi-Fi sector)
CONFIG_XIP_KERNEL=y
CONFIG_XIP_PHYS_ADDR=0x10D80000
CONFIG_XIP_DEFLATED_DATA=y
CONFIG_HZ_100=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_EXPERT=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_POSIX_TIMERS=y
# The 32-bit-time syscalls (nanosleep, futex, clock_nanosleep, ppoll, ...):
# musl calls them whenever the value fits in 32 bits and only uses the
# *_time64 ones for bigger values, so without these usleep() returns at once
CONFIG_COMPAT_32BIT_TIME=y
CONFIG_BINFMT_ELF_FDPIC=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="/out/rootfs.cpio"
CONFIG_RD_GZIP=y
CONFIG_INITRAMFS_COMPRESSION_GZIP=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
# No BSD ptys (/dev/ptyp0...): 256 pairs are 512 tty devices, about 3400
# sysfs nodes, 512 device nodes and their inodes, ~800 KiB of slab.
# Everything here opens /dev/ptmx.
# CONFIG_LEGACY_PTYS is not set
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
# /proc/vmstat event counts (pswpin/pswpout for ATRANS swap, oom_kill,
# pgpgin/pgpgout, allocstall): tinyconfig leaves them out
CONFIG_VM_EVENT_COUNTERS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_RP2350_TIMER=y
CONFIG_RP2350_RINGCON=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_PANIC_TIMEOUT=0
CONFIG_RP2350_ATRANS=y
# printk ring: 8 KiB (the default 128 KiB buffer plus its descriptor
# arrays take about 530 KiB of RAM)
CONFIG_LOG_BUF_SHIFT=13
# A RAM MTD over free SRAM (rp2350.dts sram-text) holding a romfs: programs
# on it map their text in place from SRAM (tests/sramload.c)
CONFIG_MTD=y
CONFIG_MTD_CHAR=y
CONFIG_MTD_RAM=y
CONFIG_MTD_PHYSMAP=y
CONFIG_MTD_PHYSMAP_OF=y
CONFIG_MTD_MAP_BANK_WIDTH_4=y
CONFIG_MISC_FILESYSTEMS=y
CONFIG_ROMFS_FS=y
CONFIG_ROMFS_BACKED_BY_MTD=y
# /proc/memstat, /proc/memmap (mm/rp2350-memstat.inc): slab pages per cache,
# large kmallocs by caller, every page by kind
CONFIG_RP2350_MEMSTAT=y
# Whole-process swapping of ATRANS processes (rp2350-atrans-swap.c,
# docs/atrans-swap.md): needs CONFIG_BLOCK (linux-devices.fragment)
CONFIG_RP2350_ATRANS_SWAP=y
# The kernel's hot code in SRAM and first in flash (tools/hot-text.py,
# docs/performance.md)
CONFIG_RP2350_HOT_TEXT=y
