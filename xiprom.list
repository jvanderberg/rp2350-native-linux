# Files whose text runs in place from flash: they go into the xip romfs
# (mkxiprom.py, at 0x10200000) and /sbin/overlay-init binds each over its
# copy in the squashfs. Without this, nommu copies the text of every
# program and shared library from the squashfs into RAM (MmapCopy), in
# one physically contiguous piece.
# the C library and the dynamic linker, used by every FDPIC program
/lib/ld-uClibc-1.0.59.so
/lib/libuClibc-1.0.59.so
# MicroPython: 426 KiB of text, which in RAM needs a free 512 KiB block
/usr/bin/micropython.bin
# the pin tools' libraries
/usr/lib/libgpiod.so.3.1.2
/usr/lib/libgpiotools.so.1.0.0
/usr/lib/libi2c.so.0.1.1
/usr/lib/libpio.so
# busybox: overlay-init puts it in SRAM on top of this; the copy here is
# what runs if that fails
/bin/busybox
