# ATRANS programs for native RP2350 Linux: static ELF executables linked in
# the per-process window at 0x11000000 (docs/atrans.md), with
# real fork(). Thumb-2 for ARMv7-M (the M33 runs it; cortex-M4 as in
# ../buildroot.defconfig), soft-float, musl, static only.
#
# Buildroot calls ARMv7-M "no MMU"; build.sh patches a copy of Buildroot so
# this CPU may say BR2_USE_MMU (fork, ELF binaries, the MMU-only packages).
# patches/: musl reads the thread pointer with the get_tls syscall, libgcc
# has no kuser helpers or coprocessor code, and ld links executables at
# 0x11020000 (128 KiB of stack below them). gcc links statically by default.
BR2_arm=y
BR2_cortex_m4=y
BR2_ARM_SOFT_FLOAT=y
BR2_USE_MMU=y
BR2_BINFMT_ELF=y
BR2_GLOBAL_PATCH_DIR="/native/atrans/patches"
BR2_TOOLCHAIN_BUILDROOT_VENDOR="atrans"
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_KERNEL_HEADERS_6_12=y
BR2_EXTRA_GCC_CONFIG_OPTIONS="--with-specs=%{!shared:%{!r:-static}}"
BR2_STATIC_LIBS=y
BR2_OPTIMIZE_S=y
# unstripped in target/: check-atrans.py needs the Thumb mapping symbols;
# install-root.sh strips
# BR2_STRIP_strip is not set
BR2_TARGET_GENERIC_HOSTNAME="rp2350"
BR2_INIT_NONE=y
BR2_SYSTEM_BIN_SH_NONE=y
# BR2_TARGET_GENERIC_GETTY is not set
# BR2_PACKAGE_BUSYBOX is not set
# BR2_TARGET_ROOTFS_TAR is not set
# packages: the interactive userland
BR2_PACKAGE_NCURSES=y
BR2_PACKAGE_NCURSES_WCHAR=y
BR2_PACKAGE_NCURSES_TARGET_PROGS=y
BR2_PACKAGE_NCURSES_ADDITIONAL_TERMINFO="t/tmux t/tmux-256color x/xterm-color s/screen-256color"
BR2_PACKAGE_TMUX=y
BR2_PACKAGE_NANO=y
BR2_PACKAGE_MG=y
BR2_PACKAGE_LESS=y
BR2_PACKAGE_LRZSZ=y
BR2_PACKAGE_BC=y
BR2_PACKAGE_NCDU=y
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_LUA=y
BR2_PACKAGE_LUA_5_4=y
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_DROPBEAR_CLIENT=y
BR2_PACKAGE_DROPBEAR_DISABLE_REVERSEDNS=y
BR2_PACKAGE_DROPBEAR_LOCALOPTIONS_FILE="/native/atrans/dropbear-localoptions.h"
