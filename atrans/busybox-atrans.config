# /usr/bin/busybox-atrans (busybox-atrans.sh): the shell and the
# interactive applets as an ATRANS program, so that every login session and
# what runs in it can be compacted in the ATRANS pool and swapped to SD.
# Applied on top of Buildroot's busybox-minimal.config and the native userland's
# busybox.fragment (the FDPIC busybox's applets), with these changes: ash
# instead of hush (ATRANS has a real fork()), applets run without exec from
# the shell, an MMU build, and the applets below, which the FDPIC busybox
# leaves out (it has to fit the 416 KiB of SRAM).
# CONFIG_NOMMU is not set
CONFIG_STATIC=y
CONFIG_FEATURE_PREFER_APPLETS=y
CONFIG_FEATURE_SH_STANDALONE=y
CONFIG_FEATURE_SH_NOFORK=y
# CONFIG_SH_IS_HUSH is not set
CONFIG_SH_IS_ASH=y
# CONFIG_HUSH is not set
# CONFIG_SHELL_HUSH is not set
CONFIG_ASH=y
CONFIG_SHELL_ASH=y
CONFIG_ASH_OPTIMIZE_FOR_SIZE=y
CONFIG_ASH_INTERNAL_GLOB=y
CONFIG_ASH_BASH_COMPAT=y
CONFIG_ASH_JOB_CONTROL=y
CONFIG_ASH_ALIAS=y
CONFIG_ASH_RANDOM_SUPPORT=y
CONFIG_ASH_EXPAND_PRMT=y
CONFIG_ASH_ECHO=y
CONFIG_ASH_PRINTF=y
CONFIG_ASH_TEST=y
CONFIG_ASH_HELP=y
CONFIG_ASH_GETOPTS=y
CONFIG_ASH_CMDCMD=y
# Not here: what stays FDPIC (PID 1 and the fixed daemons), and what the
# userland build has as real programs (less, clear, reset from ncurses, bc,
# i2ctransfer from the pin tools). With FEATURE_PREFER_APPLETS, ash and
# start-stop-daemon run an applet instead of a program of the same name.
# CONFIG_INIT is not set
# CONFIG_LINUXRC is not set
# CONFIG_GETTY is not set
# CONFIG_LOGIN is not set
# CONFIG_TELNETD is not set
# CONFIG_UDHCPC is not set
# CONFIG_LESS is not set
# CONFIG_CLEAR is not set
# CONFIG_RESET is not set
# CONFIG_BC is not set
# CONFIG_I2CTRANSFER is not set
# reboot is /sbin/reboot, a script (post-build-devices.sh) that handles
# "reboot config"; the shell would run this applet instead
# CONFIG_REBOOT is not set
# interactive tools the FDPIC busybox leaves out
CONFIG_PSTREE=y
CONFIG_PGREP=y
CONFIG_PKILL=y
CONFIG_FEATURE_VI_COLON=y
CONFIG_FEATURE_VI_YANKMARK=y
CONFIG_FEATURE_VI_SEARCH=y
CONFIG_FEATURE_VI_USE_SIGNALS=y
CONFIG_FEATURE_VI_DOT_CMD=y
CONFIG_FEATURE_VI_READONLY=y
CONFIG_FEATURE_VI_SETOPTS=y
CONFIG_FEATURE_VI_SET=y
CONFIG_FEATURE_VI_WIN_RESIZE=y
CONFIG_FEATURE_VI_ASK_TERMINAL=y
CONFIG_FEATURE_VI_UNDO=y
# applets the FDPIC busybox leaves out
CONFIG_LFS=y
CONFIG_LONG_OPTS=y
CONFIG_BUSYBOX=y
CONFIG_FEATURE_SYSLOG=y
# text processing and editing
CONFIG_AWK=y
CONFIG_FEATURE_AWK_LIBM=y
CONFIG_FEATURE_AWK_GNU_EXTENSIONS=y
CONFIG_VI=y
CONFIG_DIFF=y
CONFIG_PATCH=y
CONFIG_CMP=y
CONFIG_STRINGS=y
CONFIG_BASE64=y
CONFIG_UNXZ=y
CONFIG_XZ=y
CONFIG_WATCH=y
CONFIG_FEATURE_SEAMLESS_XZ=y
# daemons and their tools (extras/bbs/bbsctl: setsid, inetd)
CONFIG_SETSID=y
CONFIG_INETD=y
CONFIG_CROND=y
CONFIG_FEATURE_CROND_D=y
CONFIG_CRONTAB=y
CONFIG_SYSLOGD=y
CONFIG_FEATURE_ROTATE_LOGFILE=y
CONFIG_LOGGER=y
