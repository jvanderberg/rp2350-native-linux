diff -ruN musl-orig/src/thread/arm/__set_thread_area.c musl-1.2.6/src/thread/arm/__set_thread_area.c
--- musl-orig/src/thread/arm/__set_thread_area.c	2026-03-20 10:40:00.000000000 -0500
+++ musl-1.2.6/src/thread/arm/__set_thread_area.c	2026-11-22 11:52:40.459330844 -0600
@@ -24,6 +24,33 @@
 
 extern hidden uintptr_t __a_barrier_ptr, __a_cas_ptr, __a_gettp_ptr;
 
+#if __ARM_ARCH_PROFILE == 'M'
+/* ATRANS v2 (native RP2350 Linux): the kernel stores the running thread's
+ * TLS pointer in the word at the bottom of the per-process window,
+ * 0x11000000, which user mode may read but not write, and rewrites it on
+ * set_tls and on every switch. It is used when this process has the ATRANS
+ * layout (the stack inside the window, below the program headers) and the
+ * word holds the pointer just set; elsewhere (qemu-user, other kernels)
+ * __get_tp makes the get_tls syscall. */
+#define ATRANS_WINDOW 0x11000000UL
+#define ATRANS_END 0x11400000UL
+hidden const uintptr_t *__atrans_tp_word;
+
+int __set_thread_area(void *p)
+{
+	volatile char here;
+	uintptr_t sp = (uintptr_t)&here, phdr = 0;
+	size_t *aux;
+	int r = __syscall(0xf0005, p);
+
+	for (aux = libc.auxv; aux && *aux; aux += 2)
+		if (*aux == AT_PHDR) phdr = aux[1];
+	if (!r && sp > ATRANS_WINDOW + 32 && sp < phdr && phdr < ATRANS_END
+	    && *(volatile uintptr_t *)ATRANS_WINDOW == (uintptr_t)p)
+		__atrans_tp_word = (const uintptr_t *)ATRANS_WINDOW;
+	return r;
+}
+#else
 int __set_thread_area(void *p)
 {
 #if !__ARM_ARCH_7A__ && !__ARM_ARCH_7R__ && __ARM_ARCH < 7
@@ -50,3 +77,4 @@
 #endif
 	return __syscall(0xf0005, p);
 }
+#endif
diff -ruN musl-orig/src/thread/arm/atomics.S musl-1.2.6/src/thread/arm/atomics.S
--- musl-orig/src/thread/arm/atomics.S	1969-12-31 18:00:00.000000000 -0600
