diff -ruN musl-orig/src/thread/arm/__aeabi_read_tp.S musl-1.2.6/src/thread/arm/__aeabi_read_tp.S
--- musl-orig/src/thread/arm/__aeabi_read_tp.S	1969-12-31 18:00:00.000000000 -0600
+++ musl-1.2.6/src/thread/arm/__aeabi_read_tp.S	2026-11-22 11:52:40.459479803 -0600
@@ -0,0 +1,26 @@
+.syntax unified
+.global __aeabi_read_tp
+.type __aeabi_read_tp,%function
+__aeabi_read_tp:
+#if __ARM_ARCH_PROFILE == 'M'
+	/* the ATRANS thread-pointer word if there is one (__set_thread_area.c),
+	 * else the get_tls syscall: r0 = thread pointer, all else kept */
+	ldr r0,=__atrans_tp_word
+	ldr r0,[r0]
+	cbz r0,1f
+	ldr r0,[r0]
+	bx lr
+1:	mov ip,r7
+	movw r7,#6
+	movt r7,#15
+	svc 0
+	mov r7,ip
+	bx lr
+#else
+	ldr r0,1f
+	add r0,r0,pc
+	ldr r0,[r0]
+2:	bx r0
+	.align 2
+1:	.word __a_gettp_ptr - 2b
+#endif
