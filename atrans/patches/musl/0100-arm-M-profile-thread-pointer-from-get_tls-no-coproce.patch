arm: M profile (ARMv7-M/ARMv8-M Linux, native RP2350 ATRANS programs)

There is no TPIDRURO and no kuser helper page. The thread pointer comes
from the word the ATRANS v2 kernel keeps at 0x11000000 (read-only to user
mode, rewritten on set_tls and every switch) when __set_thread_area finds
it, else from the get_tls syscall (0xf0006): in __get_tp() and
__aeabi_read_tp. The kernel has no COMPAT_32BIT_TIME, so the plain time
syscall names are the time64 ones (nothing tries nanosleep/futex/... time32
first). setjmp/longjmp save no coprocessor state, atomics.s (now .S) drops
its cp15/kuser variants, tlsdesc.S calls __aeabi_read_tp.

diff -ruN musl-orig/arch/arm/pthread_arch.h musl-1.2.6/arch/arm/pthread_arch.h
--- musl-orig/arch/arm/pthread_arch.h	2026-03-20 10:40:00.000000000 -0500
+++ musl-1.2.6/arch/arm/pthread_arch.h	2026-11-22 11:52:40.458763925 -0600
@@ -1,4 +1,25 @@
-#if ((__ARM_ARCH_6K__ || __ARM_ARCH_6KZ__ || __ARM_ARCH_6ZK__) && !__thumb__) \
+#if __ARM_ARCH_PROFILE == 'M'
+
+/* ARMv7-M/ARMv8-M: no TPIDRURO register and no kuser helpers.
+ * On native RP2350 Linux (ATRANS processes) the kernel keeps the running
+ * thread's pointer in a user-readable word, found at startup by
+ * __set_thread_area. Otherwise it comes from the get_tls syscall (0xf0006),
+ * which returns it in r0 and preserves every other register. r7 may be the
+ * frame pointer, so it is saved in ip around the call rather than declared
+ * clobbered. */
+extern hidden const uintptr_t *__atrans_tp_word;
+
+static inline uintptr_t __get_tp()
+{
+	const uintptr_t *w = __atrans_tp_word;
+	if (w) return *w;
+	register uintptr_t tp __asm__("r0");
+	__asm__ ( "mov ip, r7\n\tmovw r7, #6\n\tmovt r7, #15\n\tsvc 0\n\tmov r7, ip"
+		: "=r"(tp) : : "ip" );
+	return tp;
+}
+
+#elif ((__ARM_ARCH_6K__ || __ARM_ARCH_6KZ__ || __ARM_ARCH_6ZK__) && !__thumb__) \
  || __ARM_ARCH_7A__ || __ARM_ARCH_7R__ || __ARM_ARCH >= 7
 
 static inline uintptr_t __get_tp()
diff -ruN musl-orig/src/internal/syscall.h musl-1.2.6/src/internal/syscall.h
--- musl-orig/src/internal/syscall.h	2026-03-20 10:40:00.000000000 -0500
+++ musl-1.2.6/src/internal/syscall.h	2026-11-22 11:52:40.459949430 -0600
@@ -241,6 +241,33 @@
 #define SYS_settimeofday SYS_settimeofday_time32
 #endif
 
+#if defined(__arm__) && __ARM_ARCH_PROFILE == 'M'
+/* Native RP2350 Linux is built without COMPAT_32BIT_TIME: only the time64
+ * system calls exist. As on time64-only archs, the plain names become the
+ * time64 ones (below), so nothing tries a time32 call first and gives up
+ * on its ENOSYS (nanosleep, select, futex, ...). */
+#undef SYS_clock_gettime
+#undef SYS_clock_settime
+#undef SYS_clock_adjtime
+#undef SYS_clock_getres
+#undef SYS_clock_nanosleep
+#undef SYS_timer_gettime
+#undef SYS_timer_settime
+#undef SYS_timerfd_gettime
+#undef SYS_timerfd_settime
+#undef SYS_utimensat
+#undef SYS_pselect6
+#undef SYS_ppoll
+#undef SYS_recvmmsg
+#undef SYS_mq_timedsend
+#undef SYS_mq_timedreceive
+#undef SYS_rt_sigtimedwait
+#undef SYS_futex
+#undef SYS_sched_rr_get_interval
+#undef SYS_semtimedop
+#define SYS_semtimedop SYS_semtimedop_time64
+#endif
+
 /* Ensure that the plain syscall names are defined even for "time64-only"
  * archs. These facilitate callers passing null time arguments, and make
  * tests for establishing which to use/fallback-to more consistent when
